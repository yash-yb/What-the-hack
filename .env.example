# Copy to `.env` at the repository root. `docker compose` reads it automatically.
# This file documents the SHAPE only. Never commit a real .env or real secrets.

# --- PostgreSQL (compose service "db") ---
POSTGRES_USER=what_the_hack
POSTGRES_PASSWORD=what_the_hack
POSTGRES_DB=what_the_hack

# --- Backend (FastAPI) ---
# Inside compose the database host is "db"; for a local venv run use localhost (see backend/.env.example).
DATABASE_URL=postgresql+psycopg://what_the_hack:what_the_hack@db:5432/what_the_hack
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://192.168.65.1:3000"]
MAX_UPLOAD_SIZE_MB=50
TRAFFIC_WINDOW_SECONDS=60
# Set ENVIRONMENT=production on any shared host: it enforces a strong JWT_SECRET_KEY and
# makes the seed script require DEMO_*_PASSWORD values.
ENVIRONMENT=development
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# --- Redis (optional for the MVP; reserved for background jobs and replay state) ---
REDIS_URL=redis://redis:6379/0

# --- AI / ML ---
# Path as seen from inside the backend container. The compose mount makes the checked-in
# demo checkpoint available at this location.
WORLD_MODEL_CHECKPOINT=/app/ai/models/world_model.pt

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Optional authorised live Zeek sensor ---
# Export these in the terminal instead of committing a password. The live Compose profile
# mounts this folder read-only and tails Zeek's JSON conn.log metadata.
# WTH_ANALYST_PASSWORD=AnalystPass123!
# ZEEK_LOG_DIR=/Users/your-name/zeek-live
