# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Secrets and local config
.env
.env.local
.env.*.local
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.ipynb_checkpoints/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# A clone of this repository made inside itself. Committing it would add a gitlink
# and, worse, drag along its .env. Delete the folder when you no longer need it.
/What-the-hack/

# Scratch output
output/
tmp/
uploads/
*.log
*.sqlite3

# Raw captures and archives — never commit these
*.zip
*.pcap
*.pcapng

# Datasets. Only the small cleaned demo replay is committed; see
# ai/datasets/cleaned/README.md for why it is an exception.
ai/datasets/data/
ai/datasets/raw/
ai/datasets/cleaned/*
!ai/datasets/cleaned/README.md
!ai/datasets/cleaned/cicids2017_archive_clean.csv

# Model artifacts. Only the small demo checkpoint is committed; see
# ai/models/README.md. Commit a <model>.metadata.json beside any new artifact.
ai/models/*.pkl
ai/models/*.joblib
ai/models/*.bin
ai/models/*.onnx
ai/models/*.h5
ai/models/*.pt
ai/models/*.pth
ai/models/*.safetensors
!ai/models/world_model.pt
# Downloaded external datasets are local research inputs, never repository artifacts.
ai/datasets/external/
